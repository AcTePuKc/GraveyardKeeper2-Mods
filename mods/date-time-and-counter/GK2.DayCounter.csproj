<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GK2.DayCounter</AssemblyName>
    <RootNamespace>GK2.DayCounter</RootNamespace>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Graveyard Keeper 2</GameDir>
    <GameDataDir>$(GameDir)\GraveyardKeeper2_Data</GameDataDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Locales\*.json"
          Link="Locales\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Locales\*.json" Exclude="Locales\language-map.json"
          Link="GK2.Framework\Localization\com.actepukc.gk2.datetimeandcounter\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Framework language codes use underscores / ISO codes; keep HUD locale names unchanged. -->
    <None Include="Locales\pt-br.json" Link="GK2.Framework\Localization\com.actepukc.gk2.datetimeandcounter\pt_br.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Locales\vn.json" Link="GK2.Framework\Localization\com.actepukc.gk2.datetimeandcounter\vi.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Locales\uk-ua.json" Link="GK2.Framework\Localization\com.actepukc.gk2.datetimeandcounter\uk_ua.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Locales\uk-ua.json" Link="GK2.Framework\Localization\com.actepukc.gk2.datetimeandcounter\uk_vo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Locales\zh_cht.json" Link="GK2.Framework\Localization\com.actepukc.gk2.datetimeandcounter\zh_tw.json" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="GK2.Framework">
      <HintPath>$(BepInExDir)\plugins\GK2.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDataDir)\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LazyBearTechnology">
      <HintPath>$(GameDataDir)\Managed\LazyBearTechnology.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDataDir)\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDataDir)\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDataDir)\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDataDir)\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDataDir)\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDataDir)\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(GameDataDir)\Managed\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDataDir)\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDataDir)\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
